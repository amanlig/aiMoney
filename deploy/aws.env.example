# Copy to .env.aws on EC2; chmod 600 .env.aws. Do not commit credentials.
APP_DOMAIN=aimoney.example.com
APP_IMAGE=aimoney:latest
LOCAL_UID=1000
LOCAL_GID=1000
# Use a random URL-safe hexadecimal password (e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
AUTH_EMAIL_FROM=signin@aimoney.example.com
# EC2 instance role supplies temporary AWS credentials for SES.
# Create owner-only .secrets/auth.json separately; see deploy/README.md.
